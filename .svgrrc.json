{
  "replaceAttrValues": {
    "#18235A": "currentColor"
  },
  "svgoConfig": {
    "plugins": [
      {
        "name": "preset-default",
        "params": {
          "overrides": {
            "inlineStyles": {
              "onlyMatchedOnce": false
            },
            "removeViewBox": false,
            "removeUnknownsAndDefaults": false,
            "convertColors": false
          }
        }
      },
      {
        "name": "removeAttrs",
        "params": {
          "attrs": ["svg:style", "svg:overflow"]
        }
      }
    ]
  }
}
